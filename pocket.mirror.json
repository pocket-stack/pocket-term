{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.term-mirror",
  "name": "pocketjs-term-mirror",
  "title": "Pocket Term",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ]
    }
  },
  "app": {
    "entry": "mirror/main.tsx",
    "output": "pocketterm-mirror-main",
    "framework": "solid",
    "companions": [
      "term"
    ],
    "viewport": {
      "fixed": {
        "logical": [
          400,
          240
        ],
        "presentation": "native"
      }
    }
  }
}
